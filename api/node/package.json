{
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Husen",
		"email": "hi@husen.id",
		"url": "https://husen.id"
	},
	"scripts": {
		"db:generate": "NODE_OPTIONS='-r dotenv/config' drizzle-kit generate",
		"db:migrate": "NODE_OPTIONS='-r dotenv/config' drizzle-kit migrate",
		"db:seed": "node --import dotenv/config --import @swc-node/register/esm-register src/infrastructure/dal/seeds.ts",
		"dev:express": "node --import dotenv/config --import @swc-node/register/esm-register --watch src/infrastructure/server/express/index.ts",
		"dev:fastify": "node --import dotenv/config --import @swc-node/register/esm-register --watch src/infrastructure/server/fastify/index.ts",
		"dev:hono": "node --import dotenv/config --import @swc-node/register/esm-register --watch src/infrastructure/server/hono/index.ts",
		"dev": "run-s dev:express",
		"clean": "rimraf dist tsconfig.build.tsbuildinfo",
		"build": "run-s clean build:ts",
		"build:ts": "tsc -p tsconfig.build.json",
		"start:express": "node --import ./src/infrastructure/server/express/telemetry.js dist/infrastructure/server/express/index.js",
		"start:fastify": "node --import ./src/infrastructure/server/fastify/telemetry.js dist/infrastructure/server/fastify/index.js",
		"start:hono": "node --import ./src/infrastructure/server/hono/telemetry.js dist/infrastructure/server/hono/index.js",
		"start": "run-s start:express",
		"lint": "oxlint --ignore-path .gitignore .",
		"lint:fix": "oxlint --ignore-path .gitignore --fix .",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check .",
		"format": "run-s lint:fix fmt typecheck",
		"test": "NODE_ENV=testing vitest run",
		"test:watch": "NODE_ENV=testing vitest"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1175.0",
		"@aws-sdk/s3-request-presigner": "3.1175.0",
		"@hono/node-server": "^2.1.11",
		"@lukeed/ms": "2.0.2",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.301.2",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.2",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
		"@opentelemetry/instrumentation-express": "^0.73.0",
		"@opentelemetry/instrumentation-http": "^0.301.2",
		"@opentelemetry/instrumentation-pg": "^0.78.0",
		"@opentelemetry/instrumentation-pino": "^0.71.0",
		"@opentelemetry/resources": "^3.1.1",
		"@opentelemetry/sdk-metrics": "^3.1.1",
		"@opentelemetry/sdk-node": "^0.301.2",
		"@opentelemetry/semantic-conventions": "^1.45.0",
		"cache-manager": "7.2.9",
		"cache-manager-ioredis": "2.1.0",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"fastify": "^5.12.8",
		"hono": "^4.13.21",
		"http-status-codes": "^2.3.0",
		"ioredis": "6.0.0",
		"multer": "2.5.0",
		"pg": "8.23.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"swagger-ui-express": "^5.0.1",
		"ts-japi": "^1.12.8",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.22",
		"@swc/helpers": "^0.5.24",
		"@tsconfig/node26": "^26.0.2",
		"@tsconfig/strictest": "^2.0.9",
		"@types/cache-manager-ioredis": "2.0.8",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@types/supertest": "7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "^5.1.1",
		"dotenv": "18.0.10",
		"drizzle-kit": "^0.31.11",
		"drizzle-seed": "^0.3.1",
		"npm-run-all": "4.1.5",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"rimraf": "6.1.4",
		"supertest": "7.3.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.1.1"
	}
}
