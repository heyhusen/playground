{
	"extends": ["@tsconfig/strictest/tsconfig", "@tsconfig/node26/tsconfig"],
	"include": ["./src/**/*.ts"],
	"compilerOptions": {
		"outDir": "dist",
		// NodeNext emits native ESM (package.json has "type": "module") and keeps
		// ESM-only dependencies such as faker v10 resolvable. Relative imports
		// therefore carry explicit .js extensions.
		"module": "nodenext",
		"moduleResolution": "nodenext",
		// Keep the lib at es2023 to stay aligned with the runtime target.
		"lib": ["es2023"],
		"types": ["node", "vitest/globals"],
		"incremental": true,
		"noImplicitReturns": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noPropertyAccessFromIndexSignature": false,
		"removeComments": true
	}
}
