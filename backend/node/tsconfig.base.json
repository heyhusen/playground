{
	"extends": ["@tsconfig/strictest/tsconfig", "@tsconfig/node26/tsconfig"],
	"include": ["./src/**/*.ts"],
	"compilerOptions": {
		"outDir": "dist",
		// faker v10 is ESM-only. TS's node16 resolution rejects importing it from
		// CommonJS files, while bundler resolution still emits CommonJS here.
		"module": "commonjs",
		"moduleResolution": "bundler",
		// Keep the lib at es2023 to stay aligned with the runtime target.
		"lib": ["es2023"],
		"types": ["node", "vitest/globals"],
		"incremental": true,
		"noImplicitReturns": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noPropertyAccessFromIndexSignature": false,
		"removeComments": true
	}
}
